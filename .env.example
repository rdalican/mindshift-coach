# MindShift Coach Configuration
APP_NAME="MindShift Coach"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True
APP_BASE_URL="http://localhost:8000"

# Google Gemini API Key
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Database (In locale usa SQLite, su Railway verrà iniettata automaticamente DATABASE_URL per PostgreSQL)
DATABASE_URL="sqlite:///./mindshift.db"

# Stripe Monetization (Opzionale per test locali / produzione)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
DEFAULT_PRICING_MONTHLY="9.99"
FREE_TRIAL_DAYS=3
